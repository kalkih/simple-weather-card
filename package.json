{
  "name": "simple-weather-card",
  "version": "2.10.0",
  "description": "A minimalistic and customizable weather card for Home Assistant",
  "keywords": [
    "home-assistant",
    "homeassistant",
    "hass",
    "automation",
    "lovelace",
    "sensor",
    "weather",
    "forecast",
    "custom-cards"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/I-Simen-I/simple-weather-card.git"
  },
  "author": "Simen Søhol",
  "engines": {
    "node": ">=24.11.0"
  },
  "packageManager": "yarn@4.12.0",
  "license": "MIT",
  "devDependencies": {
    "@happy-dom/global-registrator": "^21.0.4",
    "eslint": "^10.14.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-import-x": "^4.17.1",
    "eslint-plugin-prettier": "^5.5.6",
    "happy-dom": "^21.0.4",
    "lit": "^3.3.3",
    "prettier": "^3.9.10",
    "ts-loader": "^9.6.2",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.2",
    "webpack": "^5.111.1",
    "webpack-cli": "^7.2.3"
  },
  "scripts": {
    "build": "webpack",
    "watch": "webpack --watch --mode development",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings 0",
    "test": "node --test test/*.test.mjs",
    "ha:up": "docker-compose -f dev/docker-compose.yml up -d",
    "ha:down": "docker-compose -f dev/docker-compose.yml down",
    "ha:logs": "docker-compose -f dev/docker-compose.yml logs -f"
  }
}
